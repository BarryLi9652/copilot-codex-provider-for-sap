{
  "name": "copilot-codex-provider-for-sap",
  "displayName": "Copilot Codex Provider for SAP",
  "description": "Use Codex through ChatGPT OAuth or a local Codex App Server in GitHub Copilot Chat, with SAP ABAP tooling support.",
  "version": "0.1.2",
  "publisher": "leonbwang",
  "private": true,
  "license": "UNLICENSED",
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguageModelChatProvider:copilot-codex.chatgpt-oauth",
    "onLanguageModelChatProvider:copilot-codex.local-cli",
    "onCommand:copilotCodex.chatgpt.signIn",
    "onCommand:copilotCodex.chatgpt.signInManual",
    "onCommand:copilotCodex.chatgpt.signOut",
    "onCommand:copilotCodex.chatgpt.refreshModels",
    "onCommand:copilotCodex.local.selectExecutable",
    "onCommand:copilotCodex.local.start",
    "onCommand:copilotCodex.local.restart",
    "onCommand:copilotCodex.local.stop",
    "onCommand:copilotCodex.local.refreshModels",
    "onCommand:copilotCodex.showDiagnostics",
    "onCommand:copilotCodex.clearExtensionData"
  ],
  "contributes": {
    "commands": [
      { "command": "copilotCodex.chatgpt.signIn", "title": "Copilot Codex: Sign In with ChatGPT" },
      { "command": "copilotCodex.chatgpt.signInManual", "title": "Copilot Codex: Complete ChatGPT Sign-In Manually" },
      { "command": "copilotCodex.chatgpt.signOut", "title": "Copilot Codex: Sign Out ChatGPT" },
      { "command": "copilotCodex.chatgpt.refreshModels", "title": "Copilot Codex: Refresh ChatGPT Models" },
      { "command": "copilotCodex.local.selectExecutable", "title": "Copilot Codex: Select Local Codex Executable" },
      { "command": "copilotCodex.local.start", "title": "Copilot Codex: Start Local Codex" },
      { "command": "copilotCodex.local.restart", "title": "Copilot Codex: Restart Local Codex" },
      { "command": "copilotCodex.local.stop", "title": "Copilot Codex: Stop Local Codex" },
      { "command": "copilotCodex.local.refreshModels", "title": "Copilot Codex: Refresh Local Models" },
      { "command": "copilotCodex.showDiagnostics", "title": "Copilot Codex: Show Diagnostics" },
      { "command": "copilotCodex.clearExtensionData", "title": "Copilot Codex: Clear Extension Data" }
    ],
    "configuration": {
      "title": "Copilot Codex Provider for SAP",
      "properties": {
        "copilotCodex.local.codexPath": { "type": "string", "default": "" },
        "copilotCodex.requestTimeoutSeconds": { "type": "number", "default": 600, "minimum": 10 },
        "copilotCodex.toolTimeoutSeconds": { "type": "number", "default": 300, "minimum": 30 },
        "copilotCodex.catalogCacheMinutes": { "type": "number", "default": 5, "minimum": 1 },
        "copilotCodex.sapSelectionMaxChars": { "type": "number", "default": 16000, "minimum": 1000 },
        "copilotCodex.logLevel": { "type": "string", "enum": ["error", "warn", "info", "debug"], "default": "info" }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "copilot-codex.chatgpt-oauth",
        "displayName": "Codex · ChatGPT OAuth"
      },
      {
        "vendor": "copilot-codex.local-cli",
        "displayName": "Codex · Local CLI"
      }
    ]
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && node --test \"out/test/integration/**/*.test.js\"",
    "test:extension": "npm run compile && node out/test/extension/run-test.js",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run typecheck && npm test",
    "package": "npm run check && npm run test:extension && npm run package:vsix",
    "package:vsix": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && vsce package --no-dependencies --allow-missing-repository --out dist/copilot-codex-provider-for-sap-0.1.2.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3"
  }
}
